# matrix.fattureweb.webcrawler.job — variáveis de ambiente (EXEMPLO)
# Copie para .env e preencha. NUNCA comite o .env real.
#
# NUNCA use comentário na MESMA linha de um valor. O python-dotenv remove comentário
# inline, mas o loader de .env do debugger do VS Code não — e a variável de ambiente
# ganha do arquivo, então o valor chega com o comentário grudado e a validação dos
# campos numéricos quebra. Comentário sempre em linha própria, como aqui.

# --- Credenciais Fattureweb --------------------------------------------------
FATTUREWEB_BASE_URL=
FATTUREWEB_USERNAME=
FATTUREWEB_PASSWORD=

# --- Destino BigQuery (opcional; têm default no config.py) -------------------
# Auth via ADC (gcloud auth application-default login local / SA do Job no Cloud Run).
# GCP_PROJECT=matrix-data-analytics-prd
# BQ_DATASET=ds_geracao_distribuida
# Tabela de status por instalação (sempre create-or-replace).
# BQ_TABLE=tb_status_webcrawler
# Tabela nível fatura (snapshot na 1ª execução, append incremental depois).
# BQ_TABLE_FATURAS=tb_faturas_matrix_facil_b

# --- Tuning / escopo (opcional; têm default) ---------------------------------
# PAGE_SIZE=180
# MAX_WORKERS=8
# CLIENTE_IDS=[208062, 208063]
# Nº de instalacao_id por chamada no enriquecimento do webcrawler (teto da querystring).
# WEBCRAWLER_CHUNK_SIZE=20
# Força snapshot completo da tabela de faturas, ignorando o MAX(data_criacao) gravado.
# FATURAS_FULL_REFRESH=false
